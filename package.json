{
  "name": "simdeck",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "node --test \"kit/**/*.test.js\" \"models/*.test.js\" \"tests/*.test.mjs\" \"sims/**/*.test.js\"",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "admin": "node scripts/admin.mjs",
    "check:page": "node kit/tools/check-page.mjs",
    "check:template": "node kit/tools/check-page.mjs kit/template/index.html",
    "gate": "node scripts/gate.mjs",
    "deploy": "bash scripts/deploy.sh",
    "deploy:dry": "bash scripts/deploy.sh --dry-run",
    "server:setup": "bash scripts/server-setup.sh"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
